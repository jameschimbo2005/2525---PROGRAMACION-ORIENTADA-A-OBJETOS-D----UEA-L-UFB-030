Sistema de Gestión de Inventarios (versión con persistencia en archivos y manejo robusto de excepciones)

Características clave:
- Persistencia en archivo de texto (JSON) "inventario.txt" por defecto.
- Carga automática al iniciar; crea el archivo si no existe.
- Manejo de excepciones detallado (FileNotFoundError, PermissionError, JSONDecodeError, OSError, etc.).
- Escritura atómica mediante archivo temporal + os.replace para evitar archivos corruptos.
- Respaldo automático del archivo corrupto (*.bak-YYYYmmdd-HHMMSS) y reconstrucción segura.
- Interfaz de consola con mensajes claros de éxito/fracaso de operaciones de archivo.
- Pruebas básicas ejecutables con bandera --pruebas.

Autor: (James Chimbo)
Fecha: 2025-08-24
"""
from __future__ import annotations

import json
import os
import sys
import tempfile
from dataclasses import dataclass, asdict
from datetime import datetime
from typing import Dict, List, Optional


# ==============================
# Modelo de datos
# ==============================
@dataclass
class Producto:
    codigo: str
    nombre: str
    stock: int
    precio: float

    def validar(self) -> None:
        """Valida los campos del producto.
        Lanza ValueError con mensajes claros para la UI si algo es inválido.
        """
        if not self.codigo or not self.codigo.strip():
            raise ValueError("El código no puede estar vacío.")
        if not self.nombre or not self.nombre.strip():
            raise ValueError("El nombre no puede estar vacío.")
        if not isinstance(self.stock, int):
            raise ValueError("El stock debe ser un entero.")
        if self.stock < 0:
            raise ValueError("El stock no puede ser negativo.")
        if not isinstance(self.precio, (int, float)):
            raise ValueError("El precio debe ser numérico.")
        if self.precio < 0:
            raise ValueError("El precio no puede ser negativo.")


# ==============================
# Repositorio con persistencia
# ==============================
class Inventario:
    def __init__(self, ruta_archivo: str = "inventario.txt") -> None:
        self.ruta_archivo = ruta_archivo
        # Diccionario interno para acceso O(1) por código
        self._items: Dict[str, Producto] = {}
        # Carga inicial con manejo robusto de errores
        self._cargar_desde_archivo()

    # ---------- API Pública ----------
    def agregar_producto(self, producto: Producto) -> bool:
        producto.validar()
        if producto.codigo in self._items:
            raise ValueError(f"Ya existe un producto con código '{producto.codigo}'.")
        self._items[producto.codigo] = producto
        self._guardar_a_archivo()
        return True

    def actualizar_producto(self, codigo: str, *, nombre: Optional[str] = None,
                             stock: Optional[int] = None, precio: Optional[float] = None) -> bool:
        if codigo not in self._items:
            raise KeyError(f"No existe un producto con código '{codigo}'.")
        p = self._items[codigo]
        if nombre is not None:
            if not nombre.strip():
                raise ValueError("El nombre no puede estar vacío.")
            p.nombre = nombre
        if stock is not None:
            if not isinstance(stock, int):
                raise ValueError("El stock debe ser un entero.")
            if stock < 0:
                raise ValueError("El stock no puede ser negativo.")
            p.stock = stock
        if precio is not None:
            if not isinstance(precio, (int, float)):
                raise ValueError("El precio debe ser numérico.")
            if precio < 0:
                raise ValueError("El precio no puede ser negativo.")
            p.precio = float(precio)
        # Validación final de coherencia
        p.validar()
        self._guardar_a_archivo()
        return True

    def eliminar_producto(self, codigo: str) -> bool:
        if codigo not in self._items:
            raise KeyError(f"No existe un producto con código '{codigo}'.")
        del self._items[codigo]
        self._guardar_a_archivo()
        return True

    def buscar_producto(self, codigo: str) -> Optional[Producto]:
        return self._items.get(codigo)

    def listar_productos(self) -> List[Producto]:
        return list(self._items.values())

    # ---------- Persistencia ----------
    def _cargar_desde_archivo(self) -> None:
        """Carga productos desde el archivo JSON.

        Reglas:
        - Si no existe el archivo: lo crea vacío y no lanza error.
        - Si existe pero está corrupto/inválido: renombra a .bak con timestamp y crea uno nuevo.
        - Si hay problemas de permisos: muestra mensaje claro y continúa con inventario en memoria vacío.
        """
        try:
            if not os.path.exists(self.ruta_archivo):
                # Crear archivo vacío de forma segura
                self._escribir_lista_productos([])
                print(f"[INFO] Archivo '{self.ruta_archivo}' creado (no existía).")
                return

            with open(self.ruta_archivo, 'r', encoding='utf-8') as f:
                contenido = f.read().strip()
                if not contenido:
                    # Archivo vacío: se considera inventario vacío válido
                    self._items = {}
                    return
                try:
                    data = json.loads(contenido)
                    if not isinstance(data, list):
                        raise json.JSONDecodeError("Se esperaba una lista JSON", contenido, 0)
                    recuperados: Dict[str, Producto] = {}
                    for raw in data:
                        # Validación defensiva de campos
                        codigo = str(raw.get('codigo', '')).strip()
                        nombre = str(raw.get('nombre', '')).strip()
                        stock = int(raw.get('stock', 0))
                        precio = float(raw.get('precio', 0.0))
                        prod = Producto(codigo=codigo, nombre=nombre, stock=stock, precio=precio)
                        prod.validar()
                        recuperados[codigo] = prod
                    self._items = recuperados
                except (json.JSONDecodeError, ValueError) as parse_err:
                    # Archivo corrupto: hacer respaldo y reconstruir vacío
                    print(f"[ALERTA] Archivo de inventario corrupto o inválido: {parse_err}")
                    self._respaldar_archivo_corrupto()
                    self._escribir_lista_productos([])
                    self._items = {}
                    print("[INFO] Se creó un nuevo archivo de inventario vacío.")
        except PermissionError:
            print(f"[ERROR] Permiso denegado al leer '{self.ruta_archivo}'. Continuando con inventario en memoria.")
            self._items = {}
        except FileNotFoundError:
            # Carrera rara: si se borró entre exists y open
            self._escribir_lista_productos([])
            print(f"[INFO] Archivo '{self.ruta_archivo}' no encontrado en lectura; creado nuevamente.")
        except OSError as e:
            print(f"[ERROR] Problema del sistema al leer '{self.ruta_archivo}': {e}. Inventario en memoria vacío.")
            self._items = {}

    def _guardar_a_archivo(self) -> None:
        """Guarda el inventario actual al archivo de forma atómica y segura.

        - Usa un archivo temporal en la misma carpeta y luego os.replace para evitar archivos corruptos si el proceso se interrumpe.
        - Captura y eleva excepciones relevantes para que la UI pueda notificar al usuario.
        """
        data = [asdict(p) for p in self.listar_productos()]
        try:
            self._escribir_lista_productos(data)
        except PermissionError as e:
            # Reelevar con mensaje entendible por la UI
            raise PermissionError(f"No se pudo escribir en '{self.ruta_archivo}': {e}")
        except OSError as e:
            raise OSError(f"Error del sistema al escribir '{self.ruta_archivo}': {e}")

    def _escribir_lista_productos(self, data_list: List[dict]) -> None:
        """Escribe la lista de productos al archivo de forma atómica.
        No imprime ni maneja aquí; deja que el caller decida cómo reportar.
        """
        carpeta = os.path.dirname(os.path.abspath(self.ruta_archivo)) or '.'
        # Asegurar existencia de carpeta
        os.makedirs(carpeta, exist_ok=True)
        # Escribir a archivo temporal
        fd, temp_path = tempfile.mkstemp(prefix="inventario_", suffix=".tmp", dir=carpeta, text=True)
        try:
            with os.fdopen(fd, 'w', encoding='utf-8') as tmp:
                json.dump(data_list, tmp, ensure_ascii=False, indent=2)
                tmp.flush()
                os.fsync(tmp.fileno())
            # Reemplazo atómico del archivo final
            os.replace(temp_path, self.ruta_archivo)
        except Exception:
            # Si algo falla, intentar remover el temporal
            try:
                if os.path.exists(temp_path):
                    os.remove(temp_path)
            finally:
                raise

    def _respaldar_archivo_corrupto(self) -> Optional[str]:
        """Renombra el archivo actual a .bak-<timestamp>. Devuelve la ruta del respaldo o None si falla."""
        if not os.path.exists(self.ruta_archivo):
            return None
        ts = datetime.now().strftime('%Y%m%d-%H%M%S')
        backup_path = f"{self.ruta_archivo}.bak-{ts}"
        try:
            os.replace(self.ruta_archivo, backup_path)
            print(f"[INFO] Respaldo creado: {backup_path}")
            return backup_path
        except OSError as e:
            print(f"[ADVERTENCIA] No se pudo crear respaldo del archivo corrupto: {e}")
            return None


# ==============================
# Interfaz de usuario (consola)
# ==============================
MENU = """
================= Inventario =================
1) Agregar producto
2) Actualizar producto
3) Eliminar producto
4) Buscar producto
5) Listar productos
6) Salir
==============================================
Seleccione una opción: """


def input_no_vacio(prompt: str) -> str:
    while True:
        valor = input(prompt).strip()
        if valor:
            return valor
        print("  El valor no puede estar vacío.")


def input_entero(prompt: str) -> int:
    while True:
        texto = input(prompt).strip()
        try:
            return int(texto)
        except ValueError:
            print(" Ingrese un número entero válido.")


def input_flotante(prompt: str) -> float:
    while True:
        texto = input(prompt).strip()
        try:
            return float(texto)
        except ValueError:
            print(" Ingrese un número válido (use punto decimal si aplica).")


def mostrar_producto(p: Producto) -> None:
    print(f"Código: {p.codigo} | Nombre: {p.nombre} | Stock: {p.stock} | Precio: {p.precio:.2f}")


def bucle_principal(ruta_archivo: str = "inventario.txt") -> None:
    inv = Inventario(ruta_archivo=ruta_archivo)
    print("[OK] Inventario listo. Archivo:", inv.ruta_archivo)
    while True:
        try:
            opcion = input(MENU).strip()
            if opcion == '1':
                codigo = input_no_vacio("Código: ")
                nombre = input_no_vacio("Nombre: ")
                stock = input_entero("Stock: ")
                precio = input_flotante("Precio: ")
                try:
                    inv.agregar_producto(Producto(codigo, nombre, stock, precio))
                    print(" Producto agregado y guardado en el archivo correctamente.")
                except (ValueError, PermissionError, OSError) as e:
                    print(f" No se pudo agregar el producto: {e}")
            elif opcion == '2':
                codigo = input_no_vacio("Código del producto a actualizar: ")
                print("Deje vacío para no cambiar el campo.")
                nuevo_nombre = input("Nuevo nombre: ").strip()
                texto_stock = input("Nuevo stock: ").strip()
                texto_precio = input("Nuevo precio: ").strip()
                kwargs = {}
                if nuevo_nombre:
                    kwargs['nombre'] = nuevo_nombre
                if texto_stock:
                    try:
                        kwargs['stock'] = int(texto_stock)
                    except ValueError:
                        print("  Stock inválido, se ignora.")
                if texto_precio:
                    try:
                        kwargs['precio'] = float(texto_precio)
                    except ValueError:
                        print(" Precio inválido, se ignora.")
                try:
                    inv.actualizar_producto(codigo, **kwargs)
                    print("Producto actualizado y cambios guardados.")
                except (KeyError, ValueError, PermissionError, OSError) as e:
                    print(f" No se pudo actualizar: {e}")
            elif opcion == '3':
                codigo = input_no_vacio("Código del producto a eliminar: ")
                try:
                    inv.eliminar_producto(codigo)
                    print(" Producto eliminado y archivo actualizado.")
                except (KeyError, PermissionError, OSError) as e:
                    print(f" No se pudo eliminar: {e}")
            elif opcion == '4':
                codigo = input_no_vacio("Código a buscar: ")
                p = inv.buscar_producto(codigo)
                if p:
                    mostrar_producto(p)
                else:
                    print(" No se encontró el producto.")
            elif opcion == '5':
                productos = inv.listar_productos()
                if not productos:
                    print("(Inventario vacío)")
                else:
                    for p in productos:
                        mostrar_producto(p)
            elif opcion == '6':
                print("Hasta luego")
                break
            else:
                print("Opción inválida. Intente nuevamente.")
        except KeyboardInterrupt:
            print("\n(Interrumpido por el usuario). Use la opción 6 para salir.")
        except EOFError:
            print("\nEntrada finalizada. Saliendo…")
            break


# ==============================
# Pruebas básicas (sin frameworks)
# ==============================

def _run_pruebas_temporales() -> None:
    """Ejecuta un conjunto de pruebas simples sobre un archivo temporal.

    Verifica:
    - Creación automática de archivo
    - Agregar / Actualizar / Eliminar
    - Escritura atómica y lectura
    - Manejo de archivo corrupto (simulado)
    """
    print("== Iniciando pruebas ==")
    with tempfile.TemporaryDirectory() as td:
        ruta = os.path.join(td, "inventario.txt")
        inv = Inventario(ruta)
        assert inv.listar_productos() == []
        # Agregar
        inv.agregar_producto(Producto("A1", "Agua", 10, 0.5))
        inv.agregar_producto(Producto("B2", "Pan", 5, 0.25))
        assert inv.buscar_producto("A1").nombre == "Agua"
        # Actualizar
        inv.actualizar_producto("A1", stock=20, precio=0.6)
        assert inv.buscar_producto("A1").stock == 20
        # Eliminar
        inv.eliminar_producto("B2")
        assert inv.buscar_producto("B2") is None
        # Recargar desde disco
        inv2 = Inventario(ruta)
        assert inv2.buscar_producto("A1") is not None
        # Simular archivo corrupto
        with open(ruta, 'w', encoding='utf-8') as f:
            f.write("{esto no es json}")
        inv3 = Inventario(ruta)
        assert inv3.listar_productos() == []
        print(" Todas las pruebas básicas pasaron.")


if __name__ == "__main__":
    if "--pruebas" in sys.argv:
        _run_pruebas_temporales()
    else:
        ruta = "inventario.txt"
        # Permitir ruta personalizada: python inventario.py /ruta/a/archivo.txt
        if len(sys.argv) >= 2:
            ruta = sys.argv[1]
        bucle_principal(ruta)
